; The compile-time range analysis (VarkaRangeAnalysis) is sound over Java's wrapping
; arithmetic (VARKA-281), in the form that is true: for every value of each child's
; interval there is a member of the node's interval congruent, modulo 2^32, to the lane
; value the node computes from the children's lane values. "The interval contains the
; lane value" is false past int32 - a literal shift of 2^31 - 1 carries the contract's
; interval past it while the lanes wrap - and two checks below keep that edge visible. The
; compiler reads an interval only when it lies within int32 (decomposesExactly, fitsInt, a
; magnitude at most Integer.MAX_VALUE), where the member is the lane value itself.
;
; A child with witness m in [lo, hi] has the lane value (jint.wrap m); the node's lane
; value is written with the prelude's operators as the lanes compute it, and its witness
; is written out, so every check is quantifier-free. Under INT every answer is symmetric,
; [-m, m]; under DAY a shift moves both ends. Each rule's functions ra.<node>.* are
; shared by its claim, its two neighbours narrowed by one (sat), and a pin to
; VarkaRangeAnalysis.range's own answer on a sample tree. MUL's congruence goes in Fiat's
; two layers - the ring identity as a polynomial both solvers normalise, then the wrap's
; periodicity, which is linear - and its magnitude over the reals, since over the
; integers each solver leaves one of the two unknown (VARKA-281.md 2.3). The constants
; of the day rules are VarkaRangeAnalysis's own; the divisors are the int lane's
; (VarkaProofFiles.INT_DIVISORS); a divisor of -1 is refused by Analysis before any
; emission. The file declares ALL for the reals.
;
; Rendered by VarkaProofFiles. VarkaProofFilesSuite fails when this file differs from its
; rendering, and VARKA_PROOFS_REGEN=true build/sbt 'catalyst/testOnly *VarkaProofFilesSuite'
; rewrites it. Run by dev/varka_prove.sh, which inserts java.smt2 after the set-logic line.

(set-logic ALL)

(define-fun ra.lit.m ((v Int)) Int (abs v))
(define-fun ra.dayshift.lo ((lo Int) (hi Int) (v Int)) Int (+ lo v))
(define-fun ra.dayshift.hi ((lo Int) (hi Int) (v Int)) Int (+ hi v))
(define-fun ra.nextday.lo ((lo Int) (hi Int)) Int (+ lo 1))
(define-fun ra.nextday.hi ((lo Int) (hi Int)) Int (+ hi 7))
(define-fun ra.thursday.lo ((lo Int) (hi Int)) Int (+ lo (- 3)))
(define-fun ra.thursday.hi ((lo Int) (hi Int)) Int (+ hi 3))
(define-fun ra.hull.lo ((a Int) (b Int) (c Int) (d Int)) Int (ite (<= a c) a c))
(define-fun ra.hull.hi ((a Int) (b Int) (c Int) (d Int)) Int (ite (>= b d) b d))
(define-fun ra.datediff.m ((elo Int) (ehi Int) (slo Int) (shi Int)) Int
  (ite (>= (abs (- ehi slo)) (abs (- elo shi))) (abs (- ehi slo)) (abs (- elo shi))))
(define-fun ra.add.m ((m1 Int) (m2 Int)) Int (+ m1 m2))
(define-fun ra.mul.m ((m1 Int) (m2 Int)) Int (* m1 m2))
(define-fun ra.neg.m ((m Int)) Int m)
(define-fun ra.constdiv.m ((m Int) (d Int)) Int (trunc.div m (abs d)))
(define-fun ra.boundeddiv.hi ((bound Int) (d Int)) Int (div (- bound 1) d))

(echo "LiteralSlot under INT: a literal v lies in [-|v|, |v|]: expect unsat")
(push 1)
(declare-const v Int)
(assert (jint.in v))
(assert (not (and (<= (- (ra.lit.m v)) v) (<= v (ra.lit.m v)) (= (jint.wrap v) v))))
(check-sat)
(pop 1)

(echo "LiteralSlot under INT: a literal v lies in [-|v|, |v|]: with the low end raised by one it is not: expect sat")
(push 1)
(declare-const v Int)
(assert (jint.in v))
(assert (not (and (<= (+ (- (ra.lit.m v)) 1) v) (<= v (ra.lit.m v)) (= (jint.wrap v) v))))
(check-sat)
(pop 1)

(echo "LiteralSlot under INT: a literal v lies in [-|v|, |v|]: with the high end lowered by one it is not: expect sat")
(push 1)
(declare-const v Int)
(assert (jint.in v))
(assert (not (and (<= (- (ra.lit.m v)) v) (<= v (- (ra.lit.m v) 1)) (= (jint.wrap v) v))))
(check-sat)
(pop 1)

(echo "LiteralSlot under DAY: a literal is the point [v, v]: expect unsat")
(push 1)
(declare-const v Int)
(assert (jint.in v))
(assert (not (and (<= v v) (<= v v) (= (jint.wrap v) v))))
(check-sat)
(pop 1)

(echo "AddDays by a literal v: the lane's d + v is congruent to m + v in [lo + v, hi + v]: expect unsat")
(push 1)
(declare-const lo Int) (declare-const hi Int) (declare-const m Int)
(assert (and (<= lo m) (<= m hi)))
(define-fun jc () Int (jint.wrap m))
(declare-const v Int)
(assert (jint.in v))
(assert (not (and (<= (ra.dayshift.lo lo hi v) (+ m v)) (<= (+ m v) (ra.dayshift.hi lo hi v)) (= (jint.wrap (+ m v)) (jint.add jc v)))))
(check-sat)
(pop 1)

