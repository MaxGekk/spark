(define-fun chrono.magic ((v Int) (m Int) (k Int) (d Int) (carry Bool)) Int
  (let ((q (jint.ushr (jint.mul v m) k)))
    (ite (and carry (>= (jint.sub v (jint.mul q d)) d)) (jint.add q 1) q)))

