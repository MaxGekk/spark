; The 128-bit decimal's word lowerings (VARKA-359), the ring layer. A value of precision 19
; to 38 is two long words, v = hi * 2^64 + lo, hi signed in [-2^63, 2^63) and lo read
; unsigned in [0, 2^64) (DecimalWords). The comparisons over the words are
;
;   x < y    LT(x.hi, y.hi) | (EQ(x.hi, y.hi) & ULT(x.lo, y.lo))
;   x <= y   LT(x.hi, y.hi) | (EQ(x.hi, y.hi) & ULE(x.lo, y.lo))
;   x = y    EQ(x.hi, y.hi) & EQ(x.lo, y.lo)
;   x <=> y  NullSafeEqual on each word, ANDed, the words sharing one validity bit
;
; and > and >= the first two with the operands swapped. The load's check declines a valid
; slot where gt128(u, B) | gt128(-B, u), gt128(u, c) = GT(u.hi, c.hi) | (EQ(u.hi, c.hi) &
; UGT(u.lo, c.lo)), with B = 10^p - 1 as its constant pair. Each is proven equal to the
; integer statement; a bound one off is refuted at every precision.
;
; The carry layer states the same forms as emitted: each word a Java long, the low word
; read unsigned as the long mod 2^64 (j.u), x > y and x >= y as GT and UGT, GE and UGE
; rather than swapped, the sign extension (x, x >> 63) of a 64-bit operand as the floor
; division by 2^63, and the check's constants as the code's long literals.
;
; Rendered by VarkaProofFiles. VarkaProofFilesSuite fails when this file differs from its
; rendering, and VARKA_PROOFS_REGEN=true build/sbt 'catalyst/testOnly *VarkaProofFilesSuite'
; rewrites it. Run by dev/varka_prove.sh, which inserts java.smt2 after the set-logic line.

(set-logic QF_NIA)

(define-fun w.hi ((h Int)) Bool (and (<= (- 9223372036854775808) h) (< h 9223372036854775808)))
(define-fun w.lo ((l Int)) Bool (and (<= 0 l) (< l 18446744073709551616)))
(define-fun w.val ((h Int) (l Int)) Int (+ (* 18446744073709551616 h) l))
(define-fun w.lt ((xh Int) (xl Int) (yh Int) (yl Int)) Bool
  (or (< xh yh) (and (= xh yh) (< xl yl))))
(define-fun w.le ((xh Int) (xl Int) (yh Int) (yl Int)) Bool
  (or (< xh yh) (and (= xh yh) (<= xl yl))))
(define-fun w.eq ((xh Int) (xl Int) (yh Int) (yl Int)) Bool
  (and (= xh yh) (= xl yl)))
(define-fun w.gt128 ((uh Int) (ul Int) (ch Int) (cl Int)) Bool
  (or (> uh ch) (and (= uh ch) (> ul cl))))

(echo "x < y over the words is the comparison of the values: expect unsat")
(push 1)
(declare-const xh Int)
(declare-const xl Int)
(declare-const yh Int)
(declare-const yl Int)
(assert (and (w.hi xh) (w.lo xl) (w.hi yh) (w.lo yl)))
(assert (not (= (w.lt xh xl yh yl) (< (w.val xh xl) (w.val yh yl)))))
(check-sat)
(pop 1)

