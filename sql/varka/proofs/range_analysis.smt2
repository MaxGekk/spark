(assert (jint.in v))
(assert (not (and (<= (+ (ra.dayshift.lo lo hi v) 1) (+ m v)) (<= (+ m v) (ra.dayshift.hi lo hi v)) (= (jint.wrap (+ m v)) (jint.add jc v)))))
(check-sat)
(pop 1)

