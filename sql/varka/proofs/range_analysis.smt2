(define-fun jc () Int (jint.wrap m))
(define-fun w () Int (jint.floorMod (jint.add jc 3) 7))
(define-fun jn () Int (jint.sub (jint.add jc 3) w))
(assert (not (and (<= (ra.thursday.lo lo hi) (- (+ m 3) w)) (<= (- (+ m 3) w) (ra.thursday.hi lo hi)) (= (jint.wrap (- (+ m 3) w)) jn))))
