; The integral rounding of a BIGINT at scale -k (VARKA-344), round, bround and truncate,
; is Spark's BigDecimal.setScale(-k, HALF_UP | HALF_EVEN | DOWN).longValue() for every
; long its guard admits. What VarkaRoundingCompiler.preShiftForm emits, per lane, for
; 1 <= k <= 18, d = 10^k, h = d / 2, every operation the long lane's wrapping one:
;
;   guard  x in [lo, hi]           GuardedRange: the pre-shift's window, narrowed by
;                                  ANSI's tails; a batch with a lane outside declines
;   s  = x >> 63                   0 or -1
;   a  = (x ^ s) - s               |x|, Long.MIN_VALUE giving itself
;   t  = a >>> k                   floor(|x| / 2^k), a read unsigned
;   Q  = t / 5^k                   ConstDivide, told t < preShiftBound(k, lo, hi)
;   r  = a - Q * d                 the magnitude's remainder, in [0, d)
;   M  = (Q + [up]) * d            HALF_UP:   up = r >= h
;                                  HALF_EVEN: up = r + (Q & 1) > h
;                                  DOWN:      M = Q * d
;   out = M * (s | 1)              the sign put back, s | 1 being 1 or -1
;
; At k = 19, 10^19 is past the long range: q0 = 0, r = x, and out is q times 10^19
; wrapped, q = [x >= h] - [x <= -h] (or > and <), h = 5 * 10^18; DOWN is x * 0, and so is
; every mode from k = 20.
;
; The specification is the rounding in unbounded integers: the magnitude |x| divided by
; d, raised by one past the half (HALF_UP at it too, HALF_EVEN at it for an odd
; quotient), the sign put back, times d; longValue() is its low 64 bits, jlong.wrap. It
; is pinned to BigDecimal at sample values. The division itself is not proven here:
; round_divide.smt2 proves the ConstDivide exact by each 5^k for every dividend under
; the bound the pre-shift's own guard gives, and these checks take Q as the exact floor
; of a non-negative t, beside a check per scale that the guard keeps t under the bound
; the compiler states, which ANSI's narrower guard only lowers. So the claims split at
; the quotient: over the guard the pre-shift gives floor(|x| / d), and the steps after it
; give the rounding from that Q, over every long, Long.MIN_VALUE's wrapped magnitude
; included. x ^ s is written as an ite on s, which is Java's XOR for s in {0, -1}, as
; s | 1 is, and a first check shows s is one of them. Beside the claims: each guard's end
; is tight (one past it reaches the bound, or overflows ANSI's long), and the arithmetic
; shift in place of the logical one is wrong at Long.MIN_VALUE.
;
; Rendered by VarkaProofFiles. VarkaProofFilesSuite fails when this file differs from its
; rendering, and VARKA_PROOFS_REGEN=true build/sbt 'catalyst/testOnly *VarkaProofFilesSuite'
; rewrites it. Run by dev/varka_prove.sh, which inserts java.smt2 after the set-logic line.

(set-logic ALL)

(define-fun xor.sign ((v Int) (s Int)) Int (ite (= s (- 1)) (jlong.not v) v))
(define-fun or.one ((s Int)) Int (ite (= s (- 1)) (- 1) 1))
; m * (s | 1) for s in {0, -1}, as the case split a check below shows it equal to.
(define-fun times.sign ((m Int) (s Int)) Int (ite (= s (- 1)) (jlong.neg m) m))

(define-fun rnd.half.up ((x Int) (d Int)) Int
  (let ((m (+ (div (abs x) d) (ite (>= (* 2 (mod (abs x) d)) d) 1 0))))
    (ite (< x 0) (- (* m d)) (* m d))))
(define-fun rnd.half.even ((x Int) (d Int)) Int
  (let ((q (div (abs x) d)) (r2 (* 2 (mod (abs x) d))))
    (let ((m (+ q (ite (or (> r2 d) (and (= r2 d) (= (mod q 2) 1))) 1 0))))
      (ite (< x 0) (- (* m d)) (* m d)))))
(define-fun rnd.down ((x Int) (d Int)) Int
  (let ((m (div (abs x) d)))
    (ite (< x 0) (- (* m d)) (* m d))))

; The steps after the quotient, per mode, from the magnitude a, its quotient Q and the
; sign s.
(define-fun form.half.up ((a Int) (Q Int) (s Int) (d Int) (h Int)) Int
  (let ((r (jlong.sub a (jlong.mul Q d))))
    (let ((m (jlong.mul (jlong.add Q (ite (>= r h) 1 0)) d)))
      (times.sign m s))))
(define-fun form.half.even ((a Int) (Q Int) (s Int) (d Int) (h Int)) Int
  (let ((r (jlong.sub a (jlong.mul Q d))))
    (let ((up (> (jlong.add r (jlong.and.low Q 2)) h)))
      (let ((m (jlong.mul (jlong.add Q (ite up 1 0)) d)))
        (times.sign m s)))))
(define-fun form.down ((a Int) (Q Int) (s Int) (d Int) (h Int)) Int
  (times.sign (jlong.mul Q d) s))

(echo "s = x >> 63 is 0 or -1 for every long: expect unsat")
(push 1)
(declare-const x Int)
(assert (jlong.in x))
(assert (not (or (= (jlong.shr x 63) 0) (= (jlong.shr x 63) (- 1)))))
(check-sat)
(pop 1)

(echo "m * (s | 1) is times.sign for every long m and s in {0, -1}: expect unsat")
(push 1)
(declare-const m Int) (declare-const s Int)
(assert (and (jlong.in m) (or (= s 0) (= s (- 1)))))
(assert (not (= (jlong.mul m (or.one s)) (times.sign m s))))
(check-sat)
(pop 1)

(echo "k = 1: over [-9007199254740991, 9007199254740991] the dividend a >>> k lies in [0, 4503599627370496), the bound the division is told, at most 2^52: expect unsat")
(push 1)
(declare-const x Int)
(assert (jlong.in x))
(assert (and (<= (- 9007199254740991) x) (<= x 9007199254740991)))
(declare-const s Int) (declare-const a Int) (declare-const t Int)
(assert (= s (jlong.shr x 63)))
(assert (= a (jlong.sub (xor.sign x s) s)))
(assert (= t (jlong.ushr a 1)))
(assert (not (and (<= 0 t) (< t 4503599627370496) (<= 4503599627370496 4503599627370496))))
(check-sat)
(pop 1)

