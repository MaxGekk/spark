+Node* VectorLongToMaskNode::Identity(PhaseGVN* phase) {
+  // VARKA-396 experiment: VectorLongToMask (AndL (VectorMaskToLong (VectorStoreMask m)) all-lanes)
+  // ==> VectorStoreMask m, on a target without mask registers, where both are boolean vectors.
+  const TypeVect* dst_type = bottom_type()->is_vect();
+  if (getenv("VARKA_FIX_LONG_TO_MASK") != nullptr && dst_type->isa_vectmask() == nullptr &&
+      in(1)->Opcode() == Op_AndL &&
+      in(1)->in(1)->Opcode() == Op_VectorMaskToLong &&
+      in(1)->in(2)->bottom_type()->isa_long() &&
+      in(1)->in(2)->bottom_type()->is_long()->is_con() &&
+      in(1)->in(2)->bottom_type()->is_long()->get_con() == ((1L << dst_type->length()) - 1)) {
+    Node* store = in(1)->in(1)->in(1);
+    if (store->Opcode() == Op_VectorStoreMask &&
+        store->bottom_type()->is_vect()->length() == dst_type->length() &&
+        store->bottom_type()->is_vect()->element_basic_type() == dst_type->element_basic_type()) {
+      return store;
+    }
+  }
+  return this;
+}
